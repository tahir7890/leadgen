# ============================================================
# Lead Gen .env — copy to .env and fill in real values
# ============================================================

# Supabase — MUST be the service_role secret key (starts with eyJ...)
# Found at: Supabase Dashboard → Settings → API → service_role
# DO NOT use the publishable/anon key (sb_publishable_...)
SUPABASE_URL= enter-your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY= enter-your-service-role-key-starting-with-eyJ...

# RocketReach credentials
ROCKETREACH_EMAIL= Enter-your-RocketReach-email
ROCKETREACH_PASSWORD= Enter-your-RocketReach-password

# Apify Playwright MCP Server
# Get your token at: https://console.apify.com/account/integrations
APIFY_TOKEN= Enter-your-Apify-token
# The MCP server URL — jiri-spilka actor (standard Playwright MCP)
APIFY_MCP_URL= Enter-your-MCP-server-URL

# Processing config
CONCURRENCY=2
BATCH_SIZE=50
MAX_RETRIES=3
REQUEST_DELAY_MS=2000

# Backend config
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
